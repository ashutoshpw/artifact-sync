{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Sync authentication configuration",
  "type": "object",
  "required": ["version", "serverUrl"],
  "properties": {
    "version": { "const": 1 },
    "serverUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "auth": {
      "type": "object",
      "required": ["type", "accessToken", "refreshToken", "tokenId", "expiresAt", "cachedIdentity"],
      "properties": {
        "type": { "const": "team_token" },
        "accessToken": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "refreshToken": { "type": "string", "pattern": "^as_(api|dev|rf)_[A-Za-z0-9_-]{43}$" },
        "tokenId": { "type": "string", "pattern": "^api_[0-9a-f-]{36}$" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "cachedIdentity": {
          "type": "object",
          "required": ["userId", "email", "name", "teamId", "team", "permissions"],
          "properties": {
            "userId": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "format": "email" },
            "name": { "type": "string", "minLength": 1 },
            "teamId": { "type": "string", "minLength": 1 },
            "team": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
            "permissions": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["artifacts:publish", "artifacts:read"] },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
