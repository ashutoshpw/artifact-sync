{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Sync publisher identity response",
  "type": "object",
  "required": ["publisherId", "team", "permissions", "expiresAt", "tokenId"],
  "properties": {
    "publisherId": { "type": "string", "minLength": 1 },
    "team": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "permissions": { "type": "array", "items": { "enum": ["artifacts:publish"] }, "uniqueItems": true },
    "expiresAt": { "type": "string", "format": "date-time" },
    "tokenId": { "type": "string" }
  },
  "additionalProperties": false
}
