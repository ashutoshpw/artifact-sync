{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Sync publisher token registry",
  "type": "object",
  "required": ["version", "tokens"],
  "properties": {
    "version": { "const": 1 },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tokenId", "tokenHash", "publisherId", "team", "permissions", "expiresAt"],
        "properties": {
          "tokenId": { "type": "string", "pattern": "^pub_[A-Za-z0-9_-]{1,64}$" },
          "tokenHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "publisherId": { "type": "string", "minLength": 1 },
          "team": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
          "permissions": { "type": "array", "items": { "enum": ["artifacts:publish"] }, "uniqueItems": true },
          "expiresAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
