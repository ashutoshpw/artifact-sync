{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "src/**/*.tsx", "tools/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
}
