{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifact-sync-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "artifact.w3dev.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    "R2_ACCOUNT_ID": "replace-with-account-id",
    "R2_BUCKET_NAME": "artifact-sync",
    "ARTIFACTS_PUBLIC_PREFIX": "artifacts"
  },
  "r2_buckets": [
    { "binding": "ARTIFACTS_BUCKET", "bucket_name": "artifact-sync" }
  ],
  "secrets": {
    "required": [
      "ARTIFACT_SYNC_PUBLISHER_TOKEN_REGISTRY",
      "R2_PARENT_ACCESS_KEY_ID",
      "R2_PARENT_SECRET_ACCESS_KEY"
    ]
  }
}
